<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">$([System.Environment]::GetEnvironmentVariable('CUE4PARSE_DIR'))</CUE4ParseDir>
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">../../../vendor/CUE4Parse-rocom</CUE4ParseDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
